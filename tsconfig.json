{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./cli/src",
    "outDir": "./cli/dist",

    "strict": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "sourceMap": true,

    "types": ["node"]
  },

  "include": [
    "cli/src/**/*"
  ],

  "exclude": [
    "node_modules"
  ]
}